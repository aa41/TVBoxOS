<resources>
    <style name="PhoneQuickAction">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/shape_user_focus</item>
    </style>
    <style name="PhoneQuickIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:alpha">0.85</item>
    </style>
    <style name="PhoneQuickLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#D7DDDA</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
