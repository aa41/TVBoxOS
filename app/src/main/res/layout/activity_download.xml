<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/download_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="36dp"
        android:paddingTop="16dp"
        android:paddingRight="40dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/download_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/shape_download_selectable"
            android:contentDescription="返回"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/icon_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="视频下载"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/download_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/download_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/download_manage"
            android:layout_width="76dp"
            android:layout_height="36dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/shape_download_selectable"
            android:focusable="true"
            android:gravity="center"
            android:text="管理"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/download_add"
            android:layout_width="112dp"
            android:layout_height="36dp"
            android:background="@drawable/shape_download_selectable"
            android:focusable="true"
            android:gravity="center"
            android:text="+  添加链接"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="40dp"
        android:paddingRight="40dp">

        <TextView android:id="@+id/download_tab_all"
            android:layout_width="84dp" android:layout_height="34dp"
            android:background="@drawable/shape_download_tab" android:focusable="true"
            android:gravity="center" android:textColor="@android:color/white" android:textSize="15sp" />
        <TextView android:id="@+id/download_tab_active"
            android:layout_width="96dp" android:layout_height="34dp"
            android:layout_marginLeft="8dp" android:background="@drawable/shape_download_tab"
            android:focusable="true" android:gravity="center"
            android:textColor="@android:color/white" android:textSize="15sp" />
        <TextView android:id="@+id/download_tab_paused"
            android:layout_width="96dp" android:layout_height="34dp"
            android:layout_marginLeft="8dp" android:background="@drawable/shape_download_tab"
            android:focusable="true" android:gravity="center"
            android:textColor="@android:color/white" android:textSize="15sp" />
        <TextView android:id="@+id/download_tab_done"
            android:layout_width="96dp" android:layout_height="34dp"
            android:layout_marginLeft="8dp" android:background="@drawable/shape_download_tab"
            android:focusable="true" android:gravity="center"
            android:textColor="@android:color/white" android:textSize="15sp" />
        <TextView android:id="@+id/download_tab_failed"
            android:layout_width="84dp" android:layout_height="34dp"
            android:layout_marginLeft="8dp" android:background="@drawable/shape_download_tab"
            android:focusable="true" android:gravity="center"
            android:textColor="@android:color/white" android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/download_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone">

        <TextView android:id="@+id/download_selected_count"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/download_muted"
            android:textSize="14sp" />
        <TextView android:id="@+id/download_select_all"
            android:layout_width="90dp" android:layout_height="32dp"
            android:background="@drawable/shape_download_selectable" android:focusable="true"
            android:gravity="center" android:text="全选当前"
            android:textColor="@android:color/white" android:textSize="14sp" />
        <TextView android:id="@+id/download_delete_selected"
            android:layout_width="108dp" android:layout_height="32dp"
            android:layout_marginLeft="8dp" android:background="@drawable/shape_download_selectable"
            android:focusable="true" android:gravity="center" android:text="删除所选"
            android:textColor="@color/download_error" android:textSize="14sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginLeft="40dp" android:layout_marginRight="40dp"
        android:background="@color/download_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="40dp"
            android:paddingTop="12dp"
            android:paddingRight="40dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/download_empty_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:src="@drawable/icon_empty" android:contentDescription="" />
            <TextView
                android:id="@+id/download_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/download_muted"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
