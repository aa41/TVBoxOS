<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/batch_dismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true" />

    <LinearLayout
        android:id="@+id/batch_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/shape_download_dialog"
        android:orientation="vertical"
        android:padding="@dimen/vs_15">

        <TextView
            android:id="@+id/batch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/batch_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/vs_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/batch_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/batch_all"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/shape_download_selectable"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="全选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/batch_none"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_10"
                android:background="@drawable/shape_download_selectable"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="清空"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/batch_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/batch_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/shape_download_selectable"
                android:focusable="true"
                android:gravity="center"
                android:text="取消"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/batch_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_12"
                android:layout_weight="1.5"
                android:background="@drawable/button_detail_play"
                android:focusable="true"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
